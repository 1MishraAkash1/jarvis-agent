# Copy this file to .env and fill in your real values.
# .env is git-ignored — it will never be committed.
#
# Phase 1 (Ollama, local model) needs NO key at all — nothing to put here
# yet. This file exists for Phase 4, when Jarvis talks to you over Telegram
# and needs a bot token.

# Phase 4 only — get from @BotFather on Telegram
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
