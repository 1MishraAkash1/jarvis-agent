# Copy this file to .env and fill in your real values.
# .env is git-ignored — it will never be committed.
#
# Phases 1-3 (Ollama, RAG, memory) need NO key at all. These two are only
# for Phase 4 (Telegram).

# Get from @BotFather on Telegram (send /newbot)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your own numeric Telegram user ID — message @userinfobot to get it.
# The bot ONLY replies to this ID; everyone else is silently ignored, since
# Jarvis can surface your personal notes/facts through normal conversation.
TELEGRAM_ALLOWED_USER_ID=your_numeric_telegram_user_id_here