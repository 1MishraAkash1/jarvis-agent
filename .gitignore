# Secrets — never commit these
.env
*.key

# Python
__pycache__/
*.pyc
.venv/
venv/

# Local data (grows large, personal — never commit any of this)
# Broad pattern, not just *.db/*.sqlite: Chroma (Phase 2) stores its index
# as a folder with nested binary files, which a narrower glob would miss.
data/*
!data/.gitkeep
notes/*
!notes/.gitkeep

# OS junk
.DS_Store
